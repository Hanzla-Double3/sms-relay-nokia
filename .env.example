RELAY_DATABASE=data/relay.sqlite3
# SHA256 hashes of separate random 32-byte credentials, NEVER the raw token.
RELAY_CALLERS_JSON={"server-b":{"token_sha256":"REPLACE_WITH_SHA256","devices":["nokia-01"],"admin":false},"operator":{"token_sha256":"REPLACE_WITH_OTHER_SHA256","devices":["nokia-01"],"admin":true}}
RELAY_DEVICES_JSON={"nokia-01":"REPLACE_WITH_DEVICE_SHA256"}
RELAY_DEFAULT_DEVICE=nokia-01
RELAY_ALLOW_INSECURE_LOCAL=false
RELAY_RECIPIENT_ALLOWLIST=["+923001234567"]
RELAY_QUEUE_LIMIT=100
RELAY_RATE_PER_MINUTE=10
RELAY_MIN_SEND_INTERVAL=5
# Bound outstanding dispatched/phone-received/modem submissions per device.
RELAY_MAX_INFLIGHT=1
# Keep MAX_INFLIGHT=1 to wait for each modem outcome before another dispatch.
RELAY_BULK_PENDING_LIMIT=10000
# Optional fast mode: MIN_SEND_INTERVAL=1 and RATE_PER_MINUTE=60; Android v0.5+ required.
RELAY_HEARTBEAT_TIMEOUT=75
RELAY_RECONCILIATION_SECONDS=300
RELAY_RETENTION_DAYS=30

# Optional admin dashboard (required in the deployed environment):
RELAY_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS
RELAY_ADMIN_SESSION_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
